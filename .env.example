PORT=4501
NODE_ENV=development

# Firebase Admin SDK service account (download from Firebase Console > Project Settings > Service accounts)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# GitHub personal access token (classic, repo scope) — used by the GitHub
# proxy to avoid unauthenticated rate limits (60/hr vs 5000/hr).
#   https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Image generation (test admin page) ---
# Required by the admin-only /api/carkedit/image-gen/* routes. Each provider
# is gated on its key being present; missing keys cause the UI to grey out
# the corresponding dropdown entry.
#
# Leonardo.AI (Phoenix 1.0 model):
#   https://cloud.leonardo.ai/api-access
LEONARDO_API_KEY=

# Black Forest Labs (FLUX 2 Pro — falls back to flux-pro-1.1 until 2.0 ships):
#   https://docs.bfl.ai/quick_start/create_account
FLUX_API_KEY=
# Optional override for the BFL model slug (e.g. "flux-pro-2.0" once released).
# FLUX_MODEL_SLUG=flux-pro-1.1

# --- AWS Cost Explorer ---
# IAM user with ce:GetCostAndUsage permission. Used by the financial
# dashboard to fetch AWS infrastructure costs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_COST_REGION=us-east-1

# --- Discord webhook (game / account lifecycle notifications) ---
# Fires an embed when a non-dev game starts, a game finishes, or a new
# account is created. Each deployed box uses a single URL — dev + staging
# point at the "CarkedIt Online - DevAPP" webhook; prod points at the
# production webhook. Leave unset locally to skip posts (no errors).
# Create the webhook in Discord: Server Settings → Integrations → Webhooks.
DISCORD_APP_WEBHOOK_URL=
